{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "auth",
  "title": "auth",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "@spechy/button",
    "@spechy/checkbox",
    "@spechy/input",
    "@spechy/otp-input",
    "@spechy/password-input",
    "@spechy/utils"
  ],
  "files": [
    {
      "path": "registry/spechy/blocks/auth/auth-layout.tsx",
      "content": "import type { ReactNode } from 'react'\nimport { cn } from '@/lib/utils'\n\nexport type AuthHighlight = {\n  icon: ReactNode\n  label: string\n}\n\ntype AuthLayoutProps = {\n  heading: string\n  subheading: string\n  highlights?: AuthHighlight[]\n  /** Width of the content column — single-column forms (login, register) are\n   * fine with the default `max-w-md`; multi-field or multi-step forms can\n   * override this. */\n  contentClassName?: string\n  children: ReactNode\n}\n\nfunction BrandMark() {\n  return (\n    <div className=\"relative z-10 flex items-center gap-2 self-start text-neutral-0\">\n      <span className=\"flex size-7 items-center justify-center rounded-full bg-neutral-0/10\">\n        <span className=\"size-2.5 rounded-full bg-neutral-0\" />\n      </span>\n      <span className=\"font-semibold text-lg tracking-tight\">Spechy</span>\n    </div>\n  )\n}\n\nexport function AuthLayout({\n  heading,\n  subheading,\n  highlights,\n  contentClassName,\n  children,\n}: AuthLayoutProps) {\n  return (\n    <div className=\"flex min-h-dvh flex-col lg:flex-row\">\n      <div className=\"relative hidden shrink-0 flex-col justify-between overflow-hidden bg-[linear-gradient(160deg,var(--neutral-950)_0%,var(--brand-900)_120%)] p-10 lg:flex lg:w-[380px] lg:p-12\">\n        <div\n          aria-hidden\n          className=\"pointer-events-none absolute -bottom-16 -left-20 size-64 rounded-full bg-brand-500/30 blur-3xl\"\n        />\n        <div\n          aria-hidden\n          className=\"pointer-events-none absolute -bottom-24 left-16 size-44 rounded-full bg-brand-300/20 blur-2xl\"\n        />\n        <BrandMark />\n        <div className=\"relative z-10 mt-auto space-y-4\">\n          <h1 className=\"text-h2 text-neutral-0\">{heading}</h1>\n          <p className=\"max-w-xs text-body-sm text-neutral-0/70\">{subheading}</p>\n          {highlights && highlights.length > 0 && (\n            <ul className=\"mt-8 flex flex-col gap-3.5\">\n              {highlights.map((item) => (\n                <li\n                  key={item.label}\n                  className=\"flex items-center gap-2.5 text-ui-sm text-neutral-0/70\"\n                >\n                  <span className=\"flex size-7 shrink-0 items-center justify-center rounded-full bg-neutral-0/10\">\n                    {item.icon}\n                  </span>\n                  {item.label}\n                </li>\n              ))}\n            </ul>\n          )}\n        </div>\n      </div>\n      <div className=\"flex flex-1 items-center justify-center p-6 lg:p-12\">\n        <div className={cn('w-full max-w-md animate-rise space-y-7', contentClassName)}>\n          {children}\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:block",
      "target": "~/src/blocks/auth/auth-layout.tsx"
    },
    {
      "path": "registry/spechy/blocks/auth/forgot-password-page.tsx",
      "content": "import { IconArrowLeft } from '@tabler/icons-react'\n\nimport { Button } from '@/components/ui/button'\nimport { Input } from '@/components/ui/input'\n\nimport { AuthLayout } from './auth-layout'\n\nexport function ForgotPasswordPage() {\n  return (\n    <AuthLayout\n      heading=\"Forgot your password?\"\n      subheading=\"No worries, we'll send you reset instructions.\"\n    >\n      <a\n        href=\"/login\"\n        className=\"flex w-fit items-center gap-1.5 text-sm text-text-secondary hover:text-foreground\"\n      >\n        <IconArrowLeft className=\"size-4\" />\n        Back to sign in\n      </a>\n      <div className=\"space-y-2\">\n        <h2 className=\"text-h2\">Reset your password</h2>\n        <p className=\"text-body-sm text-text-secondary\">\n          Enter the email associated with your account\n        </p>\n      </div>\n      <form onSubmit={(e) => e.preventDefault()} className=\"space-y-5\">\n        <div className=\"space-y-1.5\">\n          <label htmlFor=\"email\" className=\"font-medium text-sm\">\n            Email\n          </label>\n          <Input\n            id=\"email\"\n            name=\"email\"\n            type=\"email\"\n            autoComplete=\"email\"\n            placeholder=\"you@example.com\"\n            className=\"h-[var(--control-lg)]\"\n          />\n        </div>\n        <Button type=\"submit\" size=\"xl\" className=\"w-full font-semibold text-base\">\n          Send reset link\n        </Button>\n      </form>\n    </AuthLayout>\n  )\n}\n",
      "type": "registry:block",
      "target": "~/src/blocks/auth/forgot-password-page.tsx"
    },
    {
      "path": "registry/spechy/blocks/auth/login-page.tsx",
      "content": "import { IconLifebuoy, IconRefresh, IconShieldCheck } from '@tabler/icons-react'\n\nimport { Button } from '@/components/ui/button'\nimport { Checkbox } from '@/components/ui/checkbox'\nimport { Input } from '@/components/ui/input'\nimport { PasswordInput } from '@/components/ui/password-input'\n\nimport { AuthLayout } from './auth-layout'\nimport { FacebookIcon, GoogleIcon, MicrosoftIcon, TiktokIcon } from './social-icons'\n\nexport function LoginPage() {\n  return (\n    <AuthLayout\n      heading=\"Welcome back\"\n      subheading=\"Sign in to your account to continue where you left off.\"\n      highlights={[\n        { icon: <IconShieldCheck className=\"size-4\" />, label: 'Enterprise-grade security' },\n        { icon: <IconRefresh className=\"size-4\" />, label: 'Real-time sync across devices' },\n        { icon: <IconLifebuoy className=\"size-4\" />, label: '24/7 support when you need it' },\n      ]}\n    >\n      <div className=\"space-y-2\">\n        <h2 className=\"text-h2\">Sign in</h2>\n        <p className=\"text-body-sm text-text-secondary\">\n          Enter your email and password to access your account\n        </p>\n      </div>\n      <form onSubmit={(e) => e.preventDefault()} className=\"space-y-5\">\n        <div className=\"space-y-1.5\">\n          <label htmlFor=\"email\" className=\"font-medium text-sm\">\n            Email\n          </label>\n          <Input\n            id=\"email\"\n            name=\"email\"\n            type=\"email\"\n            autoComplete=\"email\"\n            placeholder=\"you@example.com\"\n            className=\"h-[var(--control-lg)]\"\n          />\n        </div>\n        <div className=\"space-y-1.5\">\n          <label htmlFor=\"password\" className=\"font-medium text-sm\">\n            Password\n          </label>\n          <PasswordInput\n            id=\"password\"\n            name=\"password\"\n            autoComplete=\"current-password\"\n            placeholder=\"Enter your password\"\n            className=\"h-[var(--control-lg)]\"\n          />\n        </div>\n        <div className=\"flex items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-2\">\n            <Checkbox id=\"rememberMe\" name=\"rememberMe\" />\n            <label htmlFor=\"rememberMe\" className=\"text-sm\">\n              Remember me\n            </label>\n          </div>\n          <a\n            href=\"/forgot-password\"\n            className=\"whitespace-nowrap font-medium text-primary text-sm hover:underline\"\n          >\n            Forgot password?\n          </a>\n        </div>\n        <Button type=\"submit\" size=\"xl\" className=\"w-full font-semibold text-base\">\n          Sign in\n        </Button>\n        <div className=\"flex items-center gap-3\">\n          <span className=\"h-px flex-1 bg-border\" />\n          <span className=\"text-text-secondary text-xs\">Or continue with</span>\n          <span className=\"h-px flex-1 bg-border\" />\n        </div>\n        <div className=\"flex gap-3\">\n          <Button type=\"button\" variant=\"outline\" size=\"lg\" className=\"flex-1 px-0\" aria-label=\"Continue with Google\">\n            <GoogleIcon className=\"size-[18px]\" />\n          </Button>\n          <Button type=\"button\" variant=\"outline\" size=\"lg\" className=\"flex-1 px-0\" aria-label=\"Continue with Facebook\">\n            <FacebookIcon className=\"size-[18px]\" />\n          </Button>\n          <Button type=\"button\" variant=\"outline\" size=\"lg\" className=\"flex-1 px-0\" aria-label=\"Continue with Microsoft\">\n            <MicrosoftIcon className=\"size-4\" />\n          </Button>\n          <Button type=\"button\" variant=\"outline\" size=\"lg\" className=\"flex-1 px-0\" aria-label=\"Continue with TikTok\">\n            <TiktokIcon className=\"size-[18px]\" />\n          </Button>\n        </div>\n        <p className=\"text-center text-text-secondary text-sm\">\n          Don&apos;t have an account?{' '}\n          <a href=\"/register\" className=\"text-primary hover:underline\">\n            Sign up\n          </a>\n        </p>\n        <p className=\"text-center text-text-secondary text-xs\">\n          <a href=\"/privacy\" className=\"hover:underline\">\n            Privacy Policy\n          </a>\n          {' · '}\n          <a href=\"/terms\" className=\"hover:underline\">\n            Terms of Service\n          </a>\n        </p>\n      </form>\n    </AuthLayout>\n  )\n}\n",
      "type": "registry:block",
      "target": "~/src/blocks/auth/login-page.tsx"
    },
    {
      "path": "registry/spechy/blocks/auth/register-page.tsx",
      "content": "import { IconBolt, IconShield, IconUsers } from '@tabler/icons-react'\n\nimport { Button } from '@/components/ui/button'\nimport { Checkbox } from '@/components/ui/checkbox'\nimport { Input } from '@/components/ui/input'\nimport { PasswordInput } from '@/components/ui/password-input'\n\nimport { AuthLayout } from './auth-layout'\nimport { FacebookIcon, GoogleIcon, MicrosoftIcon, TiktokIcon } from './social-icons'\n\nexport function RegisterPage() {\n  return (\n    <AuthLayout\n      heading=\"Create your account\"\n      subheading=\"Set up your workspace in minutes and start collaborating with your team.\"\n      highlights={[\n        { icon: <IconBolt className=\"size-4\" />, label: 'Get up and running instantly' },\n        { icon: <IconUsers className=\"size-4\" />, label: 'Invite your whole team' },\n        { icon: <IconShield className=\"size-4\" />, label: 'Bank-level data protection' },\n      ]}\n    >\n      <div className=\"space-y-2\">\n        <h2 className=\"text-h2\">Sign up</h2>\n        <p className=\"text-body-sm text-text-secondary\">Fill in your details to get started</p>\n      </div>\n      <form onSubmit={(e) => e.preventDefault()} className=\"space-y-5\">\n        <div className=\"space-y-1.5\">\n          <label htmlFor=\"namesurname\" className=\"font-medium text-sm\">\n            Full name\n          </label>\n          <Input\n            id=\"namesurname\"\n            name=\"namesurname\"\n            autoComplete=\"name\"\n            placeholder=\"Jane Doe\"\n            className=\"h-[var(--control-lg)]\"\n          />\n        </div>\n        <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2\">\n          <div className=\"space-y-1.5\">\n            <label htmlFor=\"email\" className=\"font-medium text-sm\">\n              Email\n            </label>\n            <Input\n              id=\"email\"\n              name=\"email\"\n              type=\"email\"\n              autoComplete=\"email\"\n              placeholder=\"you@example.com\"\n              className=\"h-[var(--control-lg)]\"\n            />\n          </div>\n          <div className=\"space-y-1.5\">\n            <label htmlFor=\"phone\" className=\"font-medium text-sm\">\n              Phone\n            </label>\n            <Input\n              id=\"phone\"\n              name=\"phone\"\n              type=\"tel\"\n              autoComplete=\"tel\"\n              placeholder=\"+1 555 000 0000\"\n              className=\"h-[var(--control-lg)]\"\n            />\n          </div>\n        </div>\n        <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2\">\n          <div className=\"space-y-1.5\">\n            <label htmlFor=\"password\" className=\"font-medium text-sm\">\n              Password\n            </label>\n            <PasswordInput\n              id=\"password\"\n              name=\"password\"\n              autoComplete=\"new-password\"\n              placeholder=\"Create a password\"\n              className=\"h-[var(--control-lg)]\"\n            />\n          </div>\n          <div className=\"space-y-1.5\">\n            <label htmlFor=\"passwordConfirmation\" className=\"font-medium text-sm\">\n              Confirm password\n            </label>\n            <PasswordInput\n              id=\"passwordConfirmation\"\n              name=\"passwordConfirmation\"\n              autoComplete=\"new-password\"\n              placeholder=\"Re-enter your password\"\n              className=\"h-[var(--control-lg)]\"\n            />\n          </div>\n        </div>\n        <div className=\"flex items-start gap-2\">\n          <Checkbox id=\"acceptedTerms\" name=\"acceptedTerms\" className=\"mt-0.5\" />\n          <label htmlFor=\"acceptedTerms\" className=\"text-sm\">\n            I agree to the{' '}\n            <a href=\"/terms\" className=\"text-primary hover:underline\">\n              Terms of Service\n            </a>{' '}\n            and{' '}\n            <a href=\"/privacy\" className=\"text-primary hover:underline\">\n              Privacy Policy\n            </a>\n          </label>\n        </div>\n        <Button type=\"submit\" size=\"xl\" className=\"w-full font-semibold text-base\">\n          Create account\n        </Button>\n        <div className=\"flex items-center gap-3\">\n          <span className=\"h-px flex-1 bg-border\" />\n          <span className=\"text-text-secondary text-xs\">Or continue with</span>\n          <span className=\"h-px flex-1 bg-border\" />\n        </div>\n        <div className=\"flex gap-3\">\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            size=\"lg\"\n            className=\"flex-1 px-0\"\n            aria-label=\"Continue with Google\"\n          >\n            <GoogleIcon className=\"size-[18px]\" />\n          </Button>\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            size=\"lg\"\n            className=\"flex-1 px-0\"\n            aria-label=\"Continue with Facebook\"\n          >\n            <FacebookIcon className=\"size-[18px]\" />\n          </Button>\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            size=\"lg\"\n            className=\"flex-1 px-0\"\n            aria-label=\"Continue with Microsoft\"\n          >\n            <MicrosoftIcon className=\"size-4\" />\n          </Button>\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            size=\"lg\"\n            className=\"flex-1 px-0\"\n            aria-label=\"Continue with TikTok\"\n          >\n            <TiktokIcon className=\"size-[18px]\" />\n          </Button>\n        </div>\n        <p className=\"text-center text-text-secondary text-sm\">\n          Already have an account?{' '}\n          <a href=\"/login\" className=\"text-primary hover:underline\">\n            Sign in\n          </a>\n        </p>\n      </form>\n    </AuthLayout>\n  )\n}\n",
      "type": "registry:block",
      "target": "~/src/blocks/auth/register-page.tsx"
    },
    {
      "path": "registry/spechy/blocks/auth/reset-password-page.tsx",
      "content": "import { Button } from '@/components/ui/button'\nimport { PasswordInput } from '@/components/ui/password-input'\n\nimport { AuthLayout } from './auth-layout'\n\nexport function ResetPasswordPage() {\n  return (\n    <AuthLayout heading=\"Set a new password\" subheading=\"Choose a strong password for your account.\">\n      <div className=\"space-y-2\">\n        <h2 className=\"text-h2\">New password</h2>\n        <p className=\"text-body-sm text-text-secondary\">\n          Your new password must be different from previous passwords\n        </p>\n      </div>\n      <form onSubmit={(e) => e.preventDefault()} className=\"space-y-5\">\n        <div className=\"space-y-1.5\">\n          <label htmlFor=\"password\" className=\"font-medium text-sm\">\n            New password\n          </label>\n          <PasswordInput\n            id=\"password\"\n            name=\"password\"\n            autoComplete=\"new-password\"\n            placeholder=\"Enter a new password\"\n            className=\"h-[var(--control-lg)]\"\n          />\n        </div>\n        <div className=\"space-y-1.5\">\n          <label htmlFor=\"passwordConfirmation\" className=\"font-medium text-sm\">\n            Confirm new password\n          </label>\n          <PasswordInput\n            id=\"passwordConfirmation\"\n            name=\"passwordConfirmation\"\n            autoComplete=\"new-password\"\n            placeholder=\"Re-enter your new password\"\n            className=\"h-[var(--control-lg)]\"\n          />\n        </div>\n        <Button type=\"submit\" size=\"xl\" className=\"w-full font-semibold text-base\">\n          Reset password\n        </Button>\n      </form>\n    </AuthLayout>\n  )\n}\n",
      "type": "registry:block",
      "target": "~/src/blocks/auth/reset-password-page.tsx"
    },
    {
      "path": "registry/spechy/blocks/auth/social-icons.tsx",
      "content": "import type * as React from 'react'\n\nexport function GoogleIcon(props: React.SVGProps<SVGSVGElement>) {\n  return (\n    <svg viewBox=\"0 0 48 48\" aria-hidden=\"true\" {...props}>\n      <path\n        fill=\"#FFC107\"\n        d=\"M43.6 20.5H42V20H24v8h11.3C33.7 32.9 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 8 3l6-6C34.5 5.1 29.5 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.3-.1-2.7-.4-3.5z\"\n      />\n      <path\n        fill=\"#FF3D00\"\n        d=\"M6.3 14.7l6.6 4.8C14.5 15.1 18.9 12 24 12c3.1 0 5.8 1.1 8 3l6-6C34.5 5.1 29.5 3 24 3 16.3 3 9.7 7.3 6.3 14.7z\"\n      />\n      <path\n        fill=\"#4CAF50\"\n        d=\"M24 45c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 36.6 26.7 37.5 24 37.5c-5.3 0-9.7-3.4-11.3-8.1l-6.5 5C9.5 40.6 16.2 45 24 45z\"\n      />\n      <path\n        fill=\"#1976D2\"\n        d=\"M43.6 20.5H42V20H24v8h11.3c-1 3-3.1 5.5-5.8 7.1l6.2 5.2C39.9 37.5 45 31.4 45 24c0-1.3-.1-2.7-.4-3.5z\"\n      />\n    </svg>\n  )\n}\n\nexport function MicrosoftIcon(props: React.SVGProps<SVGSVGElement>) {\n  return (\n    <svg viewBox=\"0 0 23 23\" aria-hidden=\"true\" {...props}>\n      <rect x=\"1\" y=\"1\" width=\"10\" height=\"10\" fill=\"#F35325\" />\n      <rect x=\"12\" y=\"1\" width=\"10\" height=\"10\" fill=\"#81BC06\" />\n      <rect x=\"1\" y=\"12\" width=\"10\" height=\"10\" fill=\"#05A6F0\" />\n      <rect x=\"12\" y=\"12\" width=\"10\" height=\"10\" fill=\"#FFBA08\" />\n    </svg>\n  )\n}\n\nexport function FacebookIcon(props: React.SVGProps<SVGSVGElement>) {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" {...props}>\n      <path\n        fill=\"#1877F2\"\n        d=\"M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07z\"\n      />\n    </svg>\n  )\n}\n\nexport function TiktokIcon(props: React.SVGProps<SVGSVGElement>) {\n  return (\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" {...props}>\n      <path\n        fill=\"#000000\"\n        d=\"M16.6 5.82c-.9-.98-1.4-2.26-1.4-3.6h-3.14v13.44c0 1.53-1.24 2.77-2.77 2.77a2.77 2.77 0 1 1 0-5.54c.28 0 .55.04.8.12V9.9a6 6 0 0 0-.8-.05 6 6 0 1 0 6 6V9.13a8.16 8.16 0 0 0 4.76 1.53V7.5c-1.2 0-2.3-.4-3.2-1.13z\"\n      />\n    </svg>\n  )\n}\n",
      "type": "registry:block",
      "target": "~/src/blocks/auth/social-icons.tsx"
    },
    {
      "path": "registry/spechy/blocks/auth/verify-code-page.tsx",
      "content": "import { IconArrowLeft } from '@tabler/icons-react'\nimport { useState } from 'react'\n\nimport { Button } from '@/components/ui/button'\nimport { OtpInput } from '@/components/ui/otp-input'\n\nimport { AuthLayout } from './auth-layout'\n\nexport function VerifyCodePage() {\n  const [code, setCode] = useState('')\n\n  return (\n    <AuthLayout\n      heading=\"Verify your email\"\n      subheading=\"We've sent a 6-digit code to your email address.\"\n    >\n      <a\n        href=\"/login\"\n        className=\"flex w-fit items-center gap-1.5 text-sm text-text-secondary hover:text-foreground\"\n      >\n        <IconArrowLeft className=\"size-4\" />\n        Back\n      </a>\n      <div className=\"space-y-2\">\n        <h2 className=\"text-h2\">Enter verification code</h2>\n        <p className=\"text-body-sm text-text-secondary\">\n          Enter the 6-digit code we sent to your email\n        </p>\n      </div>\n      <form onSubmit={(e) => e.preventDefault()} className=\"space-y-5\">\n        <OtpInput id=\"code\" value={code} onChange={setCode} />\n        <Button type=\"submit\" size=\"xl\" className=\"w-full font-semibold text-base\">\n          Verify\n        </Button>\n        <p className=\"text-center text-sm text-text-secondary\">\n          Didn&apos;t receive a code?{' '}\n          <button type=\"button\" className=\"font-medium text-primary hover:underline\">\n            Resend\n          </button>\n        </p>\n      </form>\n    </AuthLayout>\n  )\n}\n",
      "type": "registry:block",
      "target": "~/src/blocks/auth/verify-code-page.tsx"
    }
  ],
  "type": "registry:block"
}